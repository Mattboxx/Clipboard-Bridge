# Public port used by the web interface and API.
APP_PORT=5088

# Persistent host directory. Use an absolute path in Dockge/Portainer.
DATA_ROOT=./data

# Image tag. Use :edge only when testing unreleased changes.
APP_IMAGE=ghcr.io/mattboxx/clipboard-bridge-server:latest

# Maximum number of history entries per clipboard space.
MAX_HISTORY=200

# Maximum size of a single request or uploaded file, in megabytes.
MAX_UPLOAD_MB=64

# Optional protection for the shared API and shared web interface.
# Optional. Leave empty to keep the general API/web space open on the trusted LAN.
# Token/account query parameters are visible in plain text in URLs over HTTP.
API_TOKEN=
WEB_PASSWORD=

# Optional isolated accounts: user1:password1,user2:password2
ACCOUNTS=

# Optional path inside the container, for example /data/accounts.txt.
ACCOUNTS_FILE=
